[Unit]
Description=vLLM OpenAI-compatible server for Gemma 4
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/vllm/vllm.env
Environment=HF_HOME=/var/cache/huggingface
Environment=PYTHONUNBUFFERED=1
Environment=VLLM_USE_V2_MODEL_RUNNER=0
ExecStart=/opt/vllm/bin/vllm serve ${MODEL_ID} \
  --served-model-name ${SERVED_MODEL_NAME} \
  --host 0.0.0.0 \
  --port ${VLLM_PORT} \
  --api-key ${VLLM_API_KEY} \
  --max-model-len ${MAX_MODEL_LEN} \
  --gpu-memory-utilization ${GPU_MEMORY_UTILIZATION} \
  --cpu-offload-gb ${CPU_OFFLOAD_GB} \
  --kv-cache-memory-bytes ${KV_CACHE_MEMORY_BYTES} \
  --max-num-seqs ${MAX_NUM_SEQS} \
  --enforce-eager \
  --limit-mm-per-prompt '{"image":0,"audio":0,"video":0}' \
  --enable-auto-tool-choice \
  --tool-call-parser gemma4 \
  --reasoning-parser gemma4 \
  --chat-template /etc/vllm/tool_chat_template_gemma4.jinja
Restart=on-failure
RestartSec=15
TimeoutStartSec=infinity
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
